* create residue, build coordinated from IC table !, minimize
* 

!test CGenFF v5.0
!requires following stream files
! test_cgenff_pre_v5.0.str
! test_ic_atoms.str

bomlev -2
!bomb by errors for NBFIX terms with non-CGenFF atom types
read rtf card name @a
read para card flex name @b
bomlev 0

! read topology and parameters
! Bomb by NBFIX errors and reset to -1 after reading 
!BOMLEV -3
!read rtf card name       ../top_all36_cgenff.rtf
!read para card flex name ../par_all36_cgenff.prm
!read para card flex name ../par_all36_cgenff_increments.prm
BOMLEV 0
WRNLEV 5

open unit 90 write form name test_cgenff_5.0.ene
echu 90
echo residue names and energies

!run pre-version 5.0 test case
stream cgenff/test_cgenff_pre_v5.0.str

!run v5.0 
! number of residues and atoms to build coordinates for v5.0
stream cgenff/test_ic_atoms.str

set ires = 1
set nres = 1394

! loop over terms
label loopres

! create a solute molecule
read sequence @{r@@ires} 1
generate AAAA setup first none last none warn

set residue @{r@@ires} 

set atom1 = @{a@@ires}
set atom2 = @{b@@ires}
set atom3 = @{c@@ires}

ic seed aaaa 1 @atom1 aaaa 1 @atom2 aaaa 1 @atom3
ic build
coor copy comp

!maintain consistency with pre-version5.0 CGenFF test
update cutnb 99.0 ctofnb 98.0 ctonnb 97.0 switch vswitch inbfrq 100

energy
echo @residue_start ?ener

! save empirical coordinates
!set ofile = output/from_ic_@{r@@ires}.pdb
!open write card unit 10 name @ofile
!write  coor pdb unit 10
!* coord generated from ic table
!*

!!mini sd     nstep 200 nprint 50
!!mini powell nstep 200 nprint 50
!!mini abnr   nstep 300 nprint 50
!!coor orient rms
!!! save empirical coordinates
!!set ofile = output/charmm_opt_@{r@@ires}.pdb 
!!open write card unit 10 name @ofile
!!write  coor pdb unit 10
!!* RMSD: ?rms
!!*

dele atom sele all end

    incr ires by 1 

if @ires .le. @nres goto loopres

stop
